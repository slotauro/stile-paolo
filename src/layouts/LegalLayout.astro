---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title} noindex>
  <article class="legal container-page max-w-3xl pt-36 pb-24">
    <h1 class="heading">{title}</h1>
    <slot />
  </article>
</BaseLayout>

<style>
  .legal :global(h2) {
    margin-top: 3rem;
    font-family: var(--font-serif);
    font-size: 1.875rem;
    line-height: 1.2;
  }

  .legal :global(h3) {
    margin-top: 2rem;
    font-weight: 600;
  }

  .legal :global(p),
  .legal :global(ul) {
    margin-top: 1rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }

  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }

  .legal :global(a) {
    color: var(--color-coral-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
