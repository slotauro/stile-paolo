---
import { reviews } from '../data/reviews';
import { site } from '../data/site';

// Ohne echte Bewertungen wird der Bereich nicht gerendert.
const show = reviews.length > 0;
---

{
  show && (
    <section id="bewertungen" class="py-24 sm:py-32">
      <div class="container-page">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-2xl">
            <p class="eyebrow" data-reveal>Kundenstimmen</p>
            <h2 class="heading mt-4" data-reveal>Was unsere Kunden sagen</h2>
          </div>
          {site.googleReviewUrl && (
            <a href={site.googleReviewUrl} target="_blank" rel="noopener" class="btn-ghost text-ink" data-reveal>
              Bewertung auf Google schreiben
            </a>
          )}
        </div>

        <ul class="-mx-5 mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-6 sm:-mx-8 sm:px-8 [&::-webkit-scrollbar]:hidden">
          {reviews.map((review) => (
            <li class="flex w-[85%] shrink-0 snap-start flex-col rounded-[1.75rem] bg-white p-8 shadow-lg shadow-ink/5 sm:w-[24rem]">
              <p class="flex gap-0.5 text-coral" aria-label={`${review.rating} von 5 Sternen`}>
                {Array.from({ length: 5 }, (_, i) => (
                  <svg aria-hidden="true" class:list={['size-5', i >= review.rating && 'opacity-25']} viewBox="0 0 24 24" fill="currentColor">
                    <path d="m12 2 3 6.6 7.2.7-5.4 4.9 1.6 7.1L12 17.7l-6.4 3.6 1.6-7.1L1.8 9.3 9 8.6Z" />
                  </svg>
                ))}
              </p>
              <blockquote class="mt-5 flex-1 font-serif text-xl leading-snug">„{review.text}“</blockquote>
              <p class="mt-6 text-sm font-semibold">
                {review.name}
                {review.source && <span class="font-normal text-ink-soft"> · via {review.source}</span>}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
