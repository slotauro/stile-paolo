---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { site, navLinks } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-night pt-16 pb-24 text-white/70 sm:pb-12">
  <div class="container-page grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr]">
    <div class="flex items-start gap-5">
      <Image src={logo} alt={`${site.name} Logo`} width={72} height={97} class="w-16 rounded-lg" />
      <div>
        <p class="font-serif text-2xl text-white">{site.name}</p>
        <p class="mt-1 font-serif text-lg text-peach italic">{site.slogan}</p>
        <p class="mt-4 text-sm leading-relaxed">
          Friseur für Damen, Herren & Kinder<br />
          {site.address.street}, {site.address.zip} {site.address.city}
        </p>
      </div>
    </div>

    <nav aria-label="Footer-Navigation">
      <p class="text-xs font-semibold tracking-[0.2em] text-white uppercase">Navigation</p>
      <ul class="mt-4 space-y-2 text-sm">
        {navLinks.map((link) => <li><a href={link.href} class="hover:text-white">{link.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <p class="text-xs font-semibold tracking-[0.2em] text-white uppercase">Folgen Sie uns</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={site.social.instagram} target="_blank" rel="noopener" class="hover:text-white">Instagram</a></li>
        <li><a href={site.social.facebook} target="_blank" rel="noopener" class="hover:text-white">Facebook</a></li>
      </ul>
    </div>
  </div>

  <div class="container-page mt-14 flex flex-wrap justify-between gap-4 border-t border-white/10 pt-8 text-xs">
    <p>© {year} {site.name} · {site.owner}</p>
    <ul class="flex gap-6">
      <li><a href="/impressum" class="hover:text-white">Impressum</a></li>
      <li><a href="/datenschutz" class="hover:text-white">Datenschutz</a></li>
    </ul>
  </div>
</footer>
