---
import { Image, getImage } from 'astro:assets';
import arbeit from '../assets/images/arbeit.jpg';
import team from '../assets/images/team.jpg';
import paoloTheke from '../assets/images/paolo-theke.jpg';
import alisa from '../assets/images/alisa.jpg';
import tatjana from '../assets/images/tatjana.jpg';
import { site } from '../data/site';

// Weitere Bilder einfach hier ergänzen. „span“ steuert die Größe im Raster.
const photos = [
  { src: arbeit, alt: 'Paolo bei der Arbeit am Fensterplatz', span: 'sm:row-span-2' },
  { src: team, alt: 'Das Team von Stile Paolo', span: 'sm:col-span-2' },
  { src: alisa, alt: 'Alisa im Salon', span: '' },
  { src: tatjana, alt: 'Tatjana im Lesesessel am Schaufenster', span: '' },
  { src: paoloTheke, alt: 'Empfang und Produktregal im Salon', span: 'sm:col-span-2' },
];

const items = await Promise.all(
  photos.map(async (photo) => ({ ...photo, full: (await getImage({ src: photo.src, width: 1600 })).src })),
);
---

<section id="galerie" class="bg-sand/60 py-24 sm:py-32">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal>Galerie</p>
        <h2 class="heading mt-4" data-reveal>Einblicke in unseren Salon</h2>
      </div>
      <a href={site.social.instagram} target="_blank" rel="noopener" class="btn-ghost text-ink" data-reveal>
        <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        Mehr auf Instagram
      </a>
    </div>

    <ul class="mt-12 grid auto-rows-[14rem] grid-cols-2 gap-3 sm:auto-rows-[16rem] sm:grid-cols-4 sm:gap-4">
      {
        items.map((photo, i) => (
          <li class:list={['overflow-hidden rounded-2xl', photo.span, i === 0 && 'col-span-2 sm:col-span-1']} data-reveal style={`--delay: ${i * 80}ms`}>
            <button type="button" class="group block h-full w-full cursor-zoom-in" data-full={photo.full} data-alt={photo.alt} aria-label={`Bild vergrößern: ${photo.alt}`}>
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[400, 800]}
                sizes="(min-width: 640px) 50vw, 100vw"
                class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog id="lightbox" class="m-auto max-h-[92vh] max-w-[92vw] bg-transparent p-0 backdrop:bg-night/90 backdrop:backdrop-blur-sm">
    <form method="dialog">
      <button class="absolute top-3 right-3 grid size-11 place-items-center rounded-full bg-white/90 text-ink shadow-lg" aria-label="Schließen">
        <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </form>
    <img id="lightbox-img" src="" alt="" class="max-h-[92vh] max-w-[92vw] rounded-xl object-contain" />
  </dialog>
</section>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;

  document.querySelectorAll<HTMLButtonElement>('#galerie [data-full]').forEach((button) => {
    button.addEventListener('click', () => {
      img.src = button.dataset.full!;
      img.alt = button.dataset.alt!;
      dialog.showModal();
    });
  });

  // Klick auf den Hintergrund schließt die Lightbox
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
</script>
