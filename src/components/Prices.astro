---
import { priceCategories } from '../data/prices';

const formatPrice = (price: string) => (/\d/.test(price) ? `${price} €` : price);
---

<section id="preise" class="py-24 sm:py-32">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow" data-reveal>Leistungen & Preise</p>
      <h2 class="heading mt-4" data-reveal>Für Donna, Uomo & Bambini</h2>
    </div>

    <div class="mx-auto mt-12 max-w-3xl" data-reveal>
      <div role="tablist" aria-label="Preiskategorien" class="mx-auto flex w-fit gap-1 rounded-full bg-sand p-1.5">
        {
          priceCategories.map((cat, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${cat.id}`}
              aria-controls={`panel-${cat.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="rounded-full px-5 py-2.5 text-sm font-semibold text-ink-soft transition aria-selected:bg-ink aria-selected:text-white aria-selected:shadow-md sm:px-7"
            >
              {cat.title}
              <span class="hidden font-normal opacity-70 sm:inline"> · {cat.subtitle}</span>
            </button>
          ))
        }
      </div>

      {
        priceCategories.map((cat, i) => (
          <div
            role="tabpanel"
            id={`panel-${cat.id}`}
            aria-labelledby={`tab-${cat.id}`}
            hidden={i !== 0}
            class="mt-10 rounded-[1.75rem] bg-white p-6 shadow-xl shadow-ink/5 sm:p-10"
          >
            <ul class="divide-y divide-ink/5">
              {cat.items.map((item) => (
                <li class="flex items-baseline gap-3 py-4">
                  <span class="text-base sm:text-lg">{item.name}</span>
                  <span aria-hidden="true" class="mb-1 flex-1 border-b border-dotted border-ink/25" />
                  <span class="shrink-0 text-right font-serif text-xl font-semibold whitespace-nowrap sm:text-2xl">
                    {item.from && <span class="mr-1 font-sans text-xs font-medium tracking-wide text-ink-soft uppercase">ab</span>}
                    {formatPrice(item.price)}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <p class="mt-6 text-center text-sm text-ink-soft">
        Alle Preise werden erst nach individueller Beratung verbindlich – z. B. abhängig von Haarlänge und Aufwand.
      </p>
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#preise [role="tab"]'));

  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const active = t === tab;
      t.setAttribute('aria-selected', String(active));
      t.tabIndex = active ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !active;
    }
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = tabs[(i + step + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });
</script>
