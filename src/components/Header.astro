---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { site, navLinks } from '../data/site';

// Auf der Startseite liegt der Header transparent über dem Hero-Bild.
const overHero = Astro.url.pathname === '/';
---

<header
  id="site-header"
  data-over-hero={overHero ? 'true' : 'false'}
  class="group fixed inset-x-0 top-0 z-50 transition-colors duration-300"
>
  <div class="container-page flex h-20 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.name} – Startseite`}>
      <Image src={logo} alt="" width={36} height={48} class="h-12 w-auto rounded-md shadow-sm" loading="eager" />
      <span class="header-text font-serif text-2xl font-semibold tracking-wide">{site.name}</span>
    </a>

    <nav aria-label="Hauptnavigation" class="hidden lg:block">
      <ul class="header-text flex items-center gap-8 text-sm font-medium">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="relative py-2 after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform hover:after:scale-x-100">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={site.phoneHref} class="btn-primary hidden sm:inline-flex">
        <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
        Termin vereinbaren
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="header-text grid size-11 place-items-center rounded-full lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menü öffnen"
      >
        <svg aria-hidden="true" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile Navigation"
    class="hidden border-t border-ink/10 bg-cream shadow-xl lg:hidden"
  >
    <ul class="container-page flex flex-col py-4">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="block border-b border-ink/5 py-4 font-serif text-2xl text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<!-- Schwebende Anruf-Leiste auf dem Handy -->
<a
  href={site.phoneHref}
  class="btn-primary fixed right-4 bottom-4 z-40 py-3.5 sm:hidden"
  aria-label={`Jetzt anrufen: ${site.phone}`}
>
  <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
  Anrufen
</a>

<style>
  #site-header {
    color: var(--color-ink);
  }

  #site-header[data-solid='true'] {
    background: color-mix(in srgb, var(--color-cream) 92%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 rgb(31 42 79 / 0.08);
  }

  #site-header[data-over-hero='true']:not([data-solid='true']) .header-text {
    color: white;
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const overHero = header.dataset.overHero === 'true';

  const update = () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    header.dataset.solid = String(!overHero || open || window.scrollY > 40);
  };

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    menu.classList.toggle('hidden', !open);
    update();
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
