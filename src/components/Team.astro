---
import { Image } from 'astro:assets';
import { team } from '../data/team';
---

<section id="team" class="bg-sand/60 py-24 sm:py-32">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow" data-reveal>Das Team</p>
      <h2 class="heading mt-4" data-reveal>Menschen mit Leidenschaft für Ihr Haar</h2>
    </div>

    <ul class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        team.map((member, i) => (
          <li class="group" data-reveal style={`--delay: ${i * 120}ms`}>
            <div class="overflow-hidden rounded-[1.75rem] bg-white shadow-lg shadow-ink/5">
              <Image
                src={member.image}
                alt={`${member.name}, ${member.role}`}
                widths={[400, 640]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="aspect-[4/5] w-full object-cover transition duration-700 group-hover:scale-105"
                style={`object-position: ${member.position ?? 'center'}`}
              />
            </div>
            <h3 class="mt-5 font-serif text-3xl font-medium">{member.name}</h3>
            <p class="mt-1 text-sm font-semibold tracking-wider text-coral-dark uppercase">{member.role}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
