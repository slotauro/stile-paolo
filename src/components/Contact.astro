---
import { site, openingHours, mapsUrl } from '../data/site';
---

<section id="kontakt" class="py-24 sm:py-32">
  <div class="container-page">
    <div class="overflow-hidden rounded-[2rem] bg-ink text-white shadow-2xl shadow-ink/20 lg:grid lg:grid-cols-[1.1fr_1fr]">
      <div class="p-8 sm:p-12 lg:p-16">
        <p class="eyebrow !text-peach" data-reveal>Kontakt</p>
        <h2 class="heading mt-4" data-reveal>Wir freuen uns auf Ihren Besuch</h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-white/75" data-reveal>
          Rufen Sie uns an oder kommen Sie vorbei – Termine sind auch außerhalb der Öffnungszeiten nach
          Vereinbarung möglich.
        </p>

        <ul class="mt-10 space-y-6 text-lg" data-reveal>
          <li class="flex gap-4">
            <svg aria-hidden="true" class="mt-1 size-5 shrink-0 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            <div>
              <address class="not-italic">{site.address.street}<br />{site.address.zip} {site.address.city}</address>
              <a href={mapsUrl} target="_blank" rel="noopener" class="mt-1 inline-block text-sm text-peach underline-offset-4 hover:underline">Route planen ↗</a>
            </div>
          </li>
          <li class="flex gap-4">
            <svg aria-hidden="true" class="mt-1 size-5 shrink-0 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
            <a href={site.phoneHref} class="hover:text-peach">{site.phone}</a>
          </li>
          <li class="flex gap-4">
            <svg aria-hidden="true" class="mt-1 size-5 shrink-0 text-peach" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <a data-email-user={site.emailUser} data-email-domain={site.emailDomain} class="break-all hover:text-peach">
              {site.emailUser} [at] {site.emailDomain}
            </a>
          </li>
        </ul>

        <div class="mt-10 flex flex-wrap gap-3" data-reveal>
          <a href={site.phoneHref} class="btn-primary">Jetzt anrufen</a>
          <a href={site.social.instagram} target="_blank" rel="noopener" class="btn-ghost">Instagram</a>
          <a href={site.social.facebook} target="_blank" rel="noopener" class="btn-ghost">Facebook</a>
        </div>
      </div>

      <div class="bg-white/5 p-8 sm:p-12 lg:p-16">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="font-serif text-3xl">Öffnungszeiten</h3>
          <p id="open-status" class="hidden items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-sm font-medium" aria-live="polite">
            <span class="size-2 rounded-full"></span><span></span>
          </p>
        </div>
        <table class="mt-8 w-full text-left">
          <caption class="sr-only">Öffnungszeiten von {site.name}</caption>
          <tbody>
            {
              openingHours.map((d) => (
                <tr data-day={d.day} class="border-b border-white/10 last:border-0">
                  <th scope="row" class="py-3.5 font-normal text-white/80">{d.label}</th>
                  <td class:list={['py-3.5 text-right tabular-nums', !d.open && 'text-white/50']}>
                    {d.open ? `${d.open} – ${d.close} Uhr` : 'geschlossen'}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mt-6 text-sm text-white/60">Termine auch nach Vereinbarung.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { openingHours } from '../data/site';

  // Aktuelle Uhrzeit in Paderborn, unabhängig von der Zeitzone des Besuchers
  const parts = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Berlin',
    weekday: 'short',
    hour: '2-digit',
    minute: '2-digit',
    hourCycle: 'h23',
  }).formatToParts(new Date());
  const get = (type: string) => parts.find((p) => p.type === type)!.value;
  const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
  const now = `${get('hour')}:${get('minute')}`;

  const today = openingHours.find((d) => d.day === day);
  const isOpen = !!today?.open && now >= today.open && now < today.close!;

  let text = 'Heute geschlossen';
  if (isOpen) text = `Jetzt geöffnet · bis ${today!.close} Uhr`;
  else if (today?.open && now < today.open) text = `Öffnet heute um ${today.open} Uhr`;
  else if (today?.open) text = 'Jetzt geschlossen';

  const status = document.getElementById('open-status')!;
  const [dot, label] = status.querySelectorAll('span');
  label.textContent = text;
  dot.style.background = isOpen ? '#6fcf97' : 'var(--color-peach)';
  status.classList.replace('hidden', 'flex');

  document.querySelector(`#kontakt tr[data-day="${day}"]`)?.classList.add('text-peach', 'font-semibold');
</script>
